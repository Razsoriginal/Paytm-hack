# Copy to .env. Never commit .env. A service with no key always runs in mock mode.
APP_ENV=dev
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=
APP_SECRET=change-me
CORS_ORIGINS=*

# Sarvam (LLM, speech-to-text, text-to-speech, translation)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_DEFAULT_LANGUAGE=hi-IN
SARVAM_AUDIO_CACHE_DIR=

# Fallback LLMs, tried in order, then the scripted mock
LLM_FALLBACK_CHAIN=sarvam,openai,gemini,mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Cognee memory graph (needs its own LLM and embedding config)
COGNEE_LLM_API_KEY=
COGNEE_LLM_MODEL=
COGNEE_EMBEDDING_MODEL=
COGNEE_DATA_DIR=
COGNEE_DATASET_MEMORY=saathi_memory
COGNEE_DATASET_SOPS=saathi_sops

# Payments: mock (default, no network) | staging (Paytm test money)
PAYTM_ENV=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING

# Force a service to mock regardless of keys: live | mock
SARVAM_MODE=
LLM_MODE=
COGNEE_MODE=
PAYTM_PG_MODE=

# Policy and experiment config
HOLDOUT_PERCENT=20
AUTO_ACTION_LIMIT_INR=2000
APPROVAL_REQUIRED_ABOVE_INR=2000
ESCALATE_ABOVE_INR=25000
CONFIDENCE_ESCALATION_THRESHOLD=0.5
CONSUMER_DAILY_SPEND_CAP_INR=20000
PLAN_APPROVAL_TTL_MIN=15
COHORT_MIN_SIZE=10
PREFERENCE_RETENTION_DAYS=180
OFFER_MAX_PER_USER_PER_WEEK=2
MOCK_PARTNER_FAILURE_RATE=0
SEED_RANDOM=42
